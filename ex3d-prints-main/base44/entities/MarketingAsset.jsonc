{
  "name": "MarketingAsset",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Unique key for this asset, e.g. moon_missions_video, heavy_lift_video, starship_video"
    },
    "label": {
      "type": "string",
      "description": "Human-readable label"
    },
    "url": {
      "type": "string",
      "description": "URL of the uploaded file or embed URL"
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}