{
  "name": "AffiliateEarnings",
  "type": "object",
  "properties": {
    "affiliate_id": {
      "type": "string",
      "description": "Affiliate's affiliate_id field"
    },
    "affiliate_user_id": {
      "type": "string",
      "description": "Affiliate's user ID"
    },
    "order_id": {
      "type": "string",
      "description": "Order ID"
    },
    "order_amount": {
      "type": "number",
      "description": "Total order amount"
    },
    "commission_amount": {
      "type": "number",
      "description": "20% of order amount owed to affiliate"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "transfer_failed"
      ],
      "default": "pending"
    },
    "paid_date": {
      "type": "string",
      "format": "date-time"
    },
    "stripe_transfer_id": {
      "type": "string"
    }
  },
  "required": [
    "affiliate_id",
    "order_id",
    "commission_amount"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.affiliate_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}