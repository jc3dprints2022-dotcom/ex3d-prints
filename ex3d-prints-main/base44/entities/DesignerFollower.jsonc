{
  "name": "DesignerFollower",
  "type": "object",
  "properties": {
    "designer_id": {
      "type": "string",
      "description": "The designer's designer_id field"
    },
    "designer_user_id": {
      "type": "string",
      "description": "The designer's user ID"
    },
    "designer_name": {
      "type": "string"
    },
    "user_id": {
      "type": "string",
      "description": "Follower's user ID (optional for guests)"
    },
    "email": {
      "type": "string",
      "description": "Follower email \u2014 required for notifications"
    },
    "name": {
      "type": "string",
      "description": "Follower display name"
    },
    "source": {
      "type": "string",
      "enum": [
        "listing_page",
        "designer_profile",
        "checkout"
      ],
      "default": "listing_page"
    },
    "opted_in_global": {
      "type": "boolean",
      "default": false,
      "description": "Also opted into EX3D global newsletter"
    }
  },
  "required": [
    "designer_id",
    "email"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}