{
  "name": "AdTrafficEvent",
  "type": "object",
  "properties": {
    "listing_id": {
      "type": "string"
    },
    "designer_id": {
      "type": "string"
    },
    "campaign_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "view",
        "click",
        "conversion"
      ],
      "default": "view"
    },
    "source": {
      "type": "string",
      "enum": [
        "ad",
        "organic",
        "email",
        "direct"
      ],
      "default": "organic"
    },
    "utm_source": {
      "type": "string"
    },
    "utm_medium": {
      "type": "string"
    },
    "utm_campaign": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    }
  },
  "required": [
    "listing_id",
    "designer_id",
    "event_type"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.designer_id": "{{user.designer_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}