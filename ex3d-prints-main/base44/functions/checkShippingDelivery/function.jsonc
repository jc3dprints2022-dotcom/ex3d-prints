{
  "name": "checkShippingDelivery",
  "entry": "entry.ts",
  "automations": [
    {
      "type": "scheduled",
      "name": "daily_delivery_check",
      "description": "Checks Shippo tracking for all shipped orders daily and marks them delivered when tracking shows DELIVERED.",
      "is_active": true,

      "schedule_mode": "recurring",
      "schedule_type": "simple",
      "repeat_unit": "days",
      "repeat_interval": 1,
      "start_time": "14:00"
    }
  ]
}
